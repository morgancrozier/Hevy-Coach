# Copy to .env only if it does not already exist. Never commit credentials.
# Required only for fetch/both; https://hevy.com/settings?developer
HEVY_API_KEY=

# Optional: used only with --ai. Chat Completions-compatible model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: used only with --email or --test-email. SMTP with STARTTLS.
EMAIL_USER=
EMAIL_PASSWORD=
# Blank recipient defaults to EMAIL_USER.
TO_EMAIL=
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
